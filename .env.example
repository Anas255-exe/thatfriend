# Copy to .env and fill in.

# From @BotFather on Telegram (/newbot). Leave empty to run the web demo only.
TELEGRAM_BOT_TOKEN=

# native   = this Node server talks to Telegram directly (simplest, recommended for the demo)
# zeroclaw = ZeroClaw owns Telegram inbound and calls this server's /api/agent/message
TELEGRAM_MODE=native

# auto = use Claude Code (your Claude login), fall back to the offline planner if unavailable
# offline = never call Claude (fully deterministic demo)
LLM_MODE=auto
CLAUDE_MODEL=sonnet
# CLAUDE_BIN=C:\path\to\claude.exe   (auto-detected from the Claude desktop app if unset)

# --- Sarvam AI (voice notes, calls, translation, sarvam-105b fallback LLM) — dashboard.sarvam.ai
SARVAM_API_KEY=
# Languages for demo friends in order (Aman, Riya, Kabir…)
DEMO_FRIEND_LANGS=hi-IN,ta-IN,en-IN

# --- Flagsmith (client-side Environment Key from Settings → Keys) — app.flagsmith.com
FLAGSMITH_ENVIRONMENT_KEY=
# FLAGSMITH_API_URL=https://edge.api.flagsmith.com

# --- NudgeBee workflow webhook (runbook-server: POST /webhook/:workflowId) + its X-Webhook-Secret
NUDGEBEE_WEBHOOK_URL=
NUDGEBEE_WEBHOOK_SECRET=

# Let AI personas reply for friends who haven't joined the bot yet (demo convenience)
SIMULATE_FRIENDS=true
PORT=8787
